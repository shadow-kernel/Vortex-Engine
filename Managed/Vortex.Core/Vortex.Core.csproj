<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Vortex.Core — the UI-framework-independent runtime + tools core, shared by the standalone player and the
    editor. It compiles the framework-free sources under Editor/ (ECS model, scene/asset formats, scripting API +
    runtime, play-mode services, native interop) as linked files, so the editor and the player run ONE implementation.
    (Until v3.1 a .NET Framework WPF editor compiled the same sources directly — #311 retired it; VORTEX_CORE is the
    only configuration left.)
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Vortex.Core</AssemblyName>
    <RootNamespace>Editor</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);VORTEX_CORE</DefineConstants>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0618;CS0649;CS0169;CS0414;CS1591;CS8632;CA1416;SYSLIB0011;SYSLIB0050;SYSLIB0051</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <!-- Windows: API keys (Anthropic, Freesound …) encrypted for the user with DPAPI (StoreKeys). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

  <!-- The host shells are one trust domain with the core (the sources were one assembly before #183). -->
  <ItemGroup>
    <InternalsVisibleTo Include="Vortex.Player" />
    <InternalsVisibleTo Include="Vortex.Editor" />
    <InternalsVisibleTo Include="Vortex.Core.Tests" />
  </ItemGroup>

  <!-- Own sources: the host abstractions the shared branches rely on. -->
  <ItemGroup>
    <Compile Include="**/*.cs" Exclude="obj/**;bin/**" />
  </ItemGroup>

  <!-- Linked sources from Editor/ (framework-free). -->
  <ItemGroup>
    <Compile Include="../../Editor/Common/ViewModelBase.cs" Link="Editor/Common/ViewModelBase.cs" />
    <Compile Include="../../Editor/Utilities/Utilities.cs" Link="Editor/Utilities/Utilities.cs" />
    <Compile Include="../../Editor/ECS/**/*.cs" Link="Editor/ECS/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../Editor/UI/Vui/*.cs" Link="Editor/UI/Vui/%(Filename)%(Extension)" />
    <Compile Include="../../Editor/DllWrapper/**/*.cs" Link="Editor/DllWrapper/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../Editor/Scripting/ScriptRuntime.cs" Link="Editor/Scripting/ScriptRuntime.cs" />
    <Compile Include="../../Editor/Scripting/DualSenseHid.cs" Link="Editor/Scripting/DualSenseHid.cs" />
    <!-- Editor-side logic that is already framework-free (view models / services the editor shells share). -->
    <Compile Include="../../Editor/Scripting/VortexScriptApi.cs" Link="Editor/Scripting/VortexScriptApi.cs" />
    <Compile Include="../../Editor/Scripting/VortexScriptApi.Vfx.cs" Link="Editor/Scripting/VortexScriptApi.Vfx.cs" />
    <Compile Include="../../Editor/Scripting/VortexScriptApi.Decal.cs" Link="Editor/Scripting/VortexScriptApi.Decal.cs" />
    <Compile Include="../../Editor/Scripting/VortexScriptApi.Ai.cs" Link="Editor/Scripting/VortexScriptApi.Ai.cs" />
    <Compile Include="../../Editor/Scripting/VortexScriptApi.Ragdoll.cs" Link="Editor/Scripting/VortexScriptApi.Ragdoll.cs" />
    <Compile Include="../../Editor/Scripting/VortexScriptApi.BehaviorTree.cs" Link="Editor/Scripting/VortexScriptApi.BehaviorTree.cs" />
    <Compile Include="../../Editor/Core/**/*.cs"
             Link="Editor/Core/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
