<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Vortex.Core.Tests — headless tests for the shared core (no window, no GPU, no native engine).
    Run: "dotnet run" in Managed/Vortex.Core.Tests (pass a name filter as the first program argument).
    Exit code 0 = all passed. Every test works in its own scratch folder; nothing touches the user's settings,
    projects or asset library (VORTEX_APPDATA_DIR / VORTEX_ASSETDB_DIR point into the scratch folder).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>VortexTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Vortex.Core/Vortex.Core.csproj" />
    <ProjectReference Include="../Vortex.Claude/Vortex.Claude.csproj" />
  </ItemGroup>

</Project>
