<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:VortexEditor.Controls"
        xmlns:p="clr-namespace:VortexEditor.Panels"
        xmlns:sh="clr-namespace:VortexEditor.Shell"
        xmlns:cl="clr-namespace:VortexEditor.Claude"
        x:Class="VortexEditor.Shell.MainWindow"
        Title="Vortex Editor" Width="1500" Height="940" MinWidth="1024" MinHeight="640"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaChromeHints="Default" ExtendClientAreaTitleBarHeightHint="52"
        Background="{DynamicResource VxWindowBrush}">
  <Grid x:Name="Root" RowDefinitions="Auto,52,*,26">
    <!-- Windows / Linux: the menu bar in a row of its own above the toolbar, where macOS has the system menu bar (on
         Windows the caption buttons sit at its right end). Empty header space is the title bar: it drags the window and
         a double-click maximizes it (macOS: the backgrounds are not hit-testable; Windows: they answer "caption"). -->
    <Panel x:Name="MenuRow" Height="30" IsVisible="False">
      <Border x:Name="MenuRowBackground" Background="{DynamicResource VxToolbarBrush}" IsHitTestVisible="False"/>
      <NativeMenuBar x:Name="MenuBarHost" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"/>
    </Panel>
    <!-- unified toolbar (the traffic lights live at its far left on macOS) -->
    <Panel Grid.Row="1" x:Name="TitleBar">
      <Border x:Name="TitleBarBackground" Background="{DynamicResource VxToolbarBrush}" Classes="hairline-bottom" IsHitTestVisible="False"/>
      <Grid ColumnDefinitions="Auto,*,Auto,*,Auto" Margin="0,0,12,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8" Margin="{Binding LeftInset}" x:Name="LeftGroup" IsHitTestVisible="False">
          <c:VxIcon Icon="Vortex" Width="20" Height="20" Foreground="{DynamicResource VxAccentBrush}" Margin="8,0,0,0"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="ProjectTitle" Text="Vortex" FontWeight="SemiBold"/>
            <TextBlock x:Name="SceneSubtitle" Text="No project" Classes="small secondary"/>
          </StackPanel>
        </StackPanel>
        <!-- centre: view tabs + play controls -->
        <StackPanel Grid.Column="2" x:Name="CenterGroup" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
          <Border Classes="segmented">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="TabScene" GroupName="view" IsChecked="True" Click="OnSceneTab" ToolTip.Tip="Build view (edit / fly camera)">Scene</RadioButton>
              <RadioButton x:Name="TabGame" GroupName="view" Click="OnGameTab" ToolTip.Tip="Game view (through the main camera)">Game</RadioButton>
            </StackPanel>
          </Border>
          <Button x:Name="ScriptButton" Classes="ghost" Click="OnScriptClick" ToolTip.Tip="Open the scripts project in your IDE"><StackPanel Orientation="Horizontal" Spacing="5"><c:VxIcon Icon="Script"/><TextBlock Text="Script"/></StackPanel></Button>
          <Border Classes="segmented" Margin="6,0,0,0">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="PlayButton" Classes="icon" Click="OnPlay" ToolTip.Tip="Play (⌘P)"><c:VxIcon x:Name="PlayIcon" Icon="Play" Foreground="{DynamicResource VxGreenBrush}"/></Button>
              <Button x:Name="PauseButton" Classes="icon" Click="OnPause" ToolTip.Tip="Pause / Resume (⇧⌘P)"><c:VxIcon x:Name="PauseIcon" Icon="Pause"/></Button>
              <Button x:Name="StopButton" Classes="icon" Click="OnStop" ToolTip.Tip="Stop" IsEnabled="False"><c:VxIcon x:Name="StopIcon" Icon="Stop"/></Button>
              <Button x:Name="PlayMenuButton" Classes="icon" Click="OnPlayMenu" ToolTip.Tip="Play options (viewport / standalone player)" Width="18"><c:VxIcon Icon="ChevronDown" Width="11" Height="11"/></Button>
            </StackPanel>
          </Border>
        </StackPanel>
        <!-- right: build / git / settings -->
        <StackPanel Grid.Column="4" x:Name="RightGroup" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
          <Button x:Name="BuildButton" Classes="ghost" Click="OnBuildClick" ToolTip.Tip="Build the game (⌘B) — right-click for Build &amp; Run / settings"><StackPanel Orientation="Horizontal" Spacing="6"><c:VxIcon Icon="Hammer"/><TextBlock Text="Build"/></StackPanel></Button>
          <Button Classes="ghost" Click="OnGitClick" ToolTip.Tip="Source control (Git)"><StackPanel Orientation="Horizontal" Spacing="6"><c:VxIcon Icon="Git"/><TextBlock Text="Git"/></StackPanel></Button>
          <Button x:Name="ClaudeToggle" Classes="ghost" Click="OnClaudeToggle" ToolTip.Tip="Claude — ask, or let it build (⌘9)"><StackPanel Orientation="Horizontal" Spacing="6"><c:VxIcon x:Name="ClaudeToggleIcon" Icon="Sparkle"/><TextBlock Text="Claude"/></StackPanel></Button>
          <Button Classes="icon" Click="OnHistoryClick" ToolTip.Tip="History — undo list (⇧⌘H)"><c:VxIcon Icon="Undo"/></Button>
          <Button Classes="icon" Click="OnSettingsClick" ToolTip.Tip="Project settings (⌘,)"><c:VxIcon Icon="Gear"/></Button>
        </StackPanel>
      </Grid>
    </Panel>

    <!-- workspace -->
    <Grid Grid.Row="2" x:Name="Workspace" ColumnDefinitions="260,5,*,5,330,0,0">
      <Grid x:Name="LeftColumn" RowDefinitions="3*,5,2*" ClipToBounds="True">
        <Border x:Name="HierarchyHost" Classes="sidebar hairline-right"><p:HierarchyPanel x:Name="Hierarchy"/></Border>
        <GridSplitter Grid.Row="1" ResizeDirection="Rows"/>
        <Border x:Name="FilesHost" Grid.Row="2" Classes="sidebar hairline-right"><p:FileTreePanel x:Name="FileTree"/></Border>
      </Grid>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns"/>
      <Grid Grid.Column="2" x:Name="CenterColumn" RowDefinitions="*,5,300" ClipToBounds="True">
        <p:ViewportPanel x:Name="ViewportPanel"/>
        <GridSplitter Grid.Row="1" ResizeDirection="Rows"/>
        <Border Grid.Row="2" x:Name="BottomDock" Classes="panel hairline-top">
          <TabControl x:Name="BottomTabs">
            <TabItem x:Name="ProjectTab" Header="Project"><p:AssetBrowserPanel x:Name="AssetBrowser"/></TabItem>
            <TabItem x:Name="LibraryTab" ToolTip.Tip="The asset library: every asset on this machine, from all projects (⌘7)">
              <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <c:VxIcon Icon="Library" Width="12" Height="12" VerticalAlignment="Center"/>
                  <TextBlock Text="Library" VerticalAlignment="Center"/>
                </StackPanel>
              </TabItem.Header>
              <p:LibraryPanel x:Name="LibraryPanel"/>
            </TabItem>
            <TabItem x:Name="StoreTab" ToolTip.Tip="Free assets (Poly Haven, ambientCG, Kenney, Sketchfab, Freesound …) and the Sound Studio (⌘8)">
              <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <c:VxIcon Icon="World" Width="12" Height="12" VerticalAlignment="Center"/>
                  <TextBlock Text="Asset Store" VerticalAlignment="Center"/>
                </StackPanel>
              </TabItem.Header>
              <p:StorePanel x:Name="StorePanel"/>
            </TabItem>
            <TabItem x:Name="ConsoleTab">
              <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="Console" VerticalAlignment="Center"/>
                  <Border x:Name="ConsoleErrorBadge" Classes="badge" Background="{DynamicResource VxRedBrush}" IsVisible="False" VerticalAlignment="Center">
                    <TextBlock x:Name="ConsoleErrorCount" Text="0" Foreground="White"/>
                  </Border>
                </StackPanel>
              </TabItem.Header>
              <p:ConsolePanel x:Name="ConsoleView"/>
            </TabItem>
            <TabItem x:Name="TerminalTab" ToolTip.Tip="Terminal — your shell in the project folder (⌃` or ⌥F12)">
              <TabItem.Header>
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <c:VxIcon Icon="Console" Width="12" Height="12" VerticalAlignment="Center"/>
                  <TextBlock Text="Terminal" VerticalAlignment="Center"/>
                </StackPanel>
              </TabItem.Header>
              <p:TerminalPanel x:Name="TerminalPanel"/>
            </TabItem>
          </TabControl>
        </Border>
      </Grid>
      <GridSplitter Grid.Column="3" ResizeDirection="Columns"/>
      <Border Grid.Column="4" x:Name="RightColumn" Classes="panel hairline-left" ClipToBounds="True">
        <TabControl x:Name="RightTabs">
          <TabItem x:Name="InspectorTab" Header="Inspector"><p:InspectorPanel x:Name="Inspector"/></TabItem>
          <TabItem x:Name="EnvironmentTab" Header="Environment"><p:EnvironmentPanel x:Name="Environment"/></TabItem>
        </TabControl>
      </Border>
      <!-- the Claude sidebar: its own column, shown and hidden like a sidebar (⌘9, View ▸ Claude, the title bar button) -->
      <GridSplitter Grid.Column="5" x:Name="ClaudeSplitter" ResizeDirection="Columns" IsVisible="False"/>
      <Border Grid.Column="6" x:Name="ClaudeColumn" Classes="panel hairline-left" IsVisible="False" MinWidth="0" ClipToBounds="True">
        <cl:ClaudePanel x:Name="ClaudePanel"/>
      </Border>
      <sh:ToastHost x:Name="Toast" Grid.ColumnSpan="7"/>
    </Grid>

    <!-- status bar -->
    <Border Grid.Row="3" Background="{DynamicResource VxToolbarBrush}" Classes="hairline-top" Padding="12,0">
      <DockPanel VerticalAlignment="Center">
        <TextBlock x:Name="ResolutionText" DockPanel.Dock="Right" Classes="small tertiary"/>
        <Button x:Name="UndoStatus" DockPanel.Dock="Right" Classes="link" Padding="0" Margin="0,0,18,0" Click="OnHistoryClick" ToolTip.Tip="Open the History (undo list)" IsVisible="False">
          <TextBlock x:Name="UndoText" Classes="small tertiary"/>
        </Button>
        <Button x:Name="ClaudeStatus" DockPanel.Dock="Right" Classes="link" Padding="0" Margin="0,0,18,0" Click="OnClaudeStatusClick">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Ellipse x:Name="ClaudeDot" Width="7" Height="7" VerticalAlignment="Center"/>
            <TextBlock x:Name="ClaudeText" Classes="small tertiary" Text="Claude"/>
          </StackPanel>
        </Button>
        <TextBlock x:Name="StatusText" Classes="small secondary" Text="Ready"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
