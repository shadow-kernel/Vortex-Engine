<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:VortexEditor.Controls"
             x:Class="VortexEditor.Panels.EnvironmentPanel">
  <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="10,10,10,12" Spacing="8">
      <TextBlock Classes="small tertiary" TextWrapping="Wrap" Margin="4,0,4,2"
                 Text="Scene environment — saved with the scene. Post effects apply to the GAME camera (play window + exported game); the build viewport stays clean."/>
      <Border Classes="card" Padding="10,6">
        <DockPanel>
          <ToggleSwitch x:Name="PreviewFx" DockPanel.Dock="Right" OnContent="" OffContent="" IsCheckedChanged="OnPreviewFx"
                        ToolTip.Tip="Temporarily shows the post effects (vignette, grain, aberration, bloom, grading) in the editor viewport for tuning. Never saved; off by default so map building stays clean."/>
          <TextBlock Text="Preview post effects in viewport" Classes="label" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>
      <StackPanel x:Name="Sections" Spacing="8"/>
      <TextBlock x:Name="NoScene" Classes="tertiary" Text="Open a project to edit its scene environment." HorizontalAlignment="Center" Margin="0,20" IsVisible="False"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
