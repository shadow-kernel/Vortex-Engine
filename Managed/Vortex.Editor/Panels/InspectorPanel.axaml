<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:VortexEditor.Controls"
             x:Class="VortexEditor.Panels.InspectorPanel">
  <DockPanel>
    <!-- Add Component stays pinned under the cards (the Windows editor's footer button) -->
    <Border x:Name="Footer" DockPanel.Dock="Bottom" Classes="hairline-top" Padding="10,8" IsVisible="False">
      <Button x:Name="AddButton" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnAddComponent"
              ToolTip.Tip="Add a component (searchable) — or drop a script / audio clip onto the inspector">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <c:VxIcon Icon="Plus" Width="12" Height="12"/>
          <TextBlock Text="Add Component"/>
        </StackPanel>
      </Button>
    </Border>
    <ScrollViewer x:Name="Scroller">
      <StackPanel Margin="10,8" Spacing="8">
        <TextBlock x:Name="NoSelection" Classes="tertiary" Text="Select an entity to edit its properties" HorizontalAlignment="Center" Margin="0,40"/>
        <Border x:Name="Header" Classes="card" IsVisible="False" Padding="10,8">
          <StackPanel Spacing="6">
            <DockPanel>
              <CheckBox x:Name="ActiveBox" DockPanel.Dock="Left" ToolTip.Tip="Active (activeSelf) — an inactive entity and its children are not rendered" IsCheckedChanged="OnActiveChanged" Margin="0,0,6,0"/>
              <Button x:Name="HeaderMenuButton" DockPanel.Dock="Right" Classes="icon small" Margin="4,0,0,0" ToolTip.Tip="Entity actions" Click="OnHeaderMenu">
                <c:VxIcon Icon="More"/>
              </Button>
              <TextBox x:Name="NameBox" FontWeight="SemiBold" LostFocus="OnNameCommit" KeyDown="OnNameKey"/>
            </DockPanel>
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" x:Name="HeaderGrid">
              <TextBlock Text="Tag" Classes="label small" Margin="2,0,8,0" VerticalAlignment="Center"/>
              <ComboBox x:Name="TagBox" Grid.Column="1" Grid.ColumnSpan="2" MinHeight="22" HorizontalAlignment="Stretch" SelectionChanged="OnTagChanged" ToolTip.Tip="Tag (scripts: Scene.FindWithTag, hit.Tag)"/>
              <TextBlock Grid.Row="1" Text="Layer" Classes="label small" Margin="2,6,8,0" VerticalAlignment="Center"/>
              <ComboBox x:Name="LayerBox" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" MinHeight="22" HorizontalAlignment="Stretch" SelectionChanged="OnLayerChanged" ToolTip.Tip="Layer (0–31)"/>
              <CheckBox x:Name="StaticBox" Grid.Row="1" Grid.Column="2" Margin="10,6,0,0" IsCheckedChanged="OnStaticChanged"
                        ToolTip.Tip="Static — the entity never moves at runtime (lets the engine treat it as level geometry)">
                <TextBlock Text="Static" Classes="small"/>
              </CheckBox>
            </Grid>
          </StackPanel>
        </Border>
        <StackPanel x:Name="PrefabHost" Spacing="0"/>
        <StackPanel x:Name="Components" Spacing="8"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
